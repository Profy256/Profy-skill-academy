# Copy to .env for `docker compose up` (or export in the shell).
# Secrets have NO defaults in code — set them for staging/prod.

# --- API ---
PORT=8080
SPRING_PROFILES_ACTIVE=local                  # local | staging | prod | worker
DATABASE_URL=jdbc:postgresql://localhost:5432/profy
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=change-me-in-prod           # HS256 signing secret (consumer + admin audiences)

# --- AI Teacher ---
# Works with ANY OpenAI-compatible API. Examples:
#   OpenRouter:  AI_BASE_URL=https://openrouter.ai/api/v1
#   OpenAI:      AI_BASE_URL=https://api.openai.com/v1
#   Gemini:      AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   Groq:        AI_BASE_URL=https://api.groq.com/openai/v1
#   Together:    AI_BASE_URL=https://api.together.xyz/v1
#   Any custom:  AI_BASE_URL=https://your-provider.com/v1
AI_BASE_URL=https://openrouter.ai/api/v1
AI_API_KEY=
AI_MODEL=openai/gpt-4o-mini
AI_FREE_MSGS_PER_DAY=20                # per-user daily cap, Free tier
AI_PREMIUM_MSGS_PER_DAY=200            # per-user daily cap, Premium tier

# --- Auto video curation (YouTube Data API v3) ---
# When set, published lessons without a curated video are auto-filled from YouTube search.
# Unset/empty = feature disabled (curated-only behavior, no errors).
YOUTUBE_API_KEY=

# --- Stripe (International payments) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- MarzPay (Local mobile money — Uganda & Kenya) ---
# Sign up: https://wallet.wearemarz.com
# Auth: HTTP Basic (base64 of "api_key:api_secret")
MARZPAY_BASE_URL=https://wallet.wearemarz.com/api/v1
MARZPAY_API_KEY=
MARZPAY_API_SECRET=
MARZPAY_CALLBACK_URL=https://your-domain.com/webhooks/marzpay

# --- Email (Resend) — certificate delivery ---
# Leave empty in dev: emails are logged and skipped, nothing breaks.
RESEND_API_KEY=
RESEND_FROM=Dera Skul <onboarding@resend.dev>

# --- Site URL — base for /verify links printed in certificate emails + PDFs ---
SITE_URL=https://deraskul.com

# --- Mobile (RevenueCat for iOS/Android) ---
REVENUECAT_WEBHOOK_AUTH=

# --- CORS ---
WEB_ORIGIN=https://deraskul.com
ADMIN_ORIGIN=https://admin.deraskul.com
